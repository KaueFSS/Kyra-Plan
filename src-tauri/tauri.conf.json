{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SentUtility",
  "version": "1.0.0",
  "identifier": "com.sentutility.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SentUtility",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "KaueFSS",
    "copyright": "© 2026 KaueFSS",
    "category": "Productivity",
    "shortDescription": "Calendário, tarefas, programação e relógios num só lugar",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczOEFFMDIxRTlBREY3NDIKUldSQzk2M3BJZUNLYytmV0dYYUlaellKd0RoQUhUUG9DWlI5VGxBdDJ6WXFXNms1eHU2a2VxeCsK",
      "endpoints": [
        "https://github.com/KaueFSS/SentUtility/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
